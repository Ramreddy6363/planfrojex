              "letterSpacing": 0.6
            },
            {
              "type": "text",
              "id": "H2mZEo",
              "name": "Why this",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "WHY THIS",
              "fontFamily": "$font-mono",
              "fontSize": 11,
              "fontWeight": "normal",
              "letterSpacing": 0.6
            },
            {
              "type": "text",
              "id": "q9BWIW",
              "name": "Alternatives considered",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "ALTERNATIVES CONSIDERED",
              "fontFamily": "$font-mono",
              "fontSize": 11,
              "fontWeight": "normal",
              "letterSpacing": 0.6
            }
          ]
        },
        {
          "type": "frame",
          "id": "T9IJT",
          "name": "Row Language",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "E8e78",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Language",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "QnERR",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "TypeScript (Node.js locally, Cloudflare Workers in production)",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fvfD7",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "The frontend is already TypeScript. One language means the API and UI share types and validation, and there is one skill set to hire for.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "y1cis",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Python (FastAPI): strong for AI, but two languages and duplicated types. Go: fast, but slower to build product features in.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "jJk6V",
          "name": "Row Repository",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "S4c3C",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Repository",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "E1Esb",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "pnpm + Turborepo monorepo",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "TwLap",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Web app, API, database schema, emails and shared types live together. One pull request changes the UI and the API at the same time.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "N2oJqs",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Two separate repos (today): types drift apart and every change needs two deploys.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "nu2ox",
          "name": "Row Frontend",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "kERlD",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Frontend",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Xaz5u",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "React 19, Vite, TanStack Router + Query, Tailwind with our tokens, Radix primitives",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "i8STFr",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Keeps what already works. The redesign is a UI rebuild, not a framework change. TanStack Query handles caching and optimistic updates for drafts and tasks.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "W6Z94D",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Next.js: server rendering adds little to an app behind a login. The landing page can be a separate static build.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "AUHud",
          "name": "Row Diagrams",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "hGMkh",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Diagrams",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "L4KrTS",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "React Flow (xyflow) + ELK.js auto-layout",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "U5JhUu",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Shapes are our own React components (rectangle, diamond, cylinder, hexagon, actor, entity table, groups), styled with our tokens so diagrams look like PlanFrojex. Drafts come back as JSON nodes and edges that match our schema, ELK lays them out, and versions can be reviewed as diffs. MIT licensed, free.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "xQtKv",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Excalidraw + Mermaid (today): hand-drawn look and a fragile text-to-shape conversion that fails most on ER diagrams. tldraw: needs a paid production licence. draw.io embed: looks like draw.io, not our app.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "pn6DW",
          "name": "Row API",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "E7DVS",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "API",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "twiie",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Hono + Zod OpenAPI",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "zKmHg",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Typed REST routes. One Zod schema validates the request, types the handler and generates OpenAPI docs and a typed client for the frontend. Built to run natively on Cloudflare Workers.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "QP8Qx",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Express (today): no types or validation. NestJS: heavy for a small team. tRPC: no public REST API for integrations and webhooks.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "FSWrl",
          "name": "Row Database",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "TGZW3",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Database",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "WK1ph",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "PostgreSQL on Neon",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "uPy57",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Workspaces, roles, tasks, decisions and approvals are relational. Accepting a draft changes many rows, so it needs transactions. JSONB still stores flexible plan sections and diagram scenes. Neon is managed, has a free tier, branch databases for previews, and a serverless driver made for Workers.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "b7wO1C",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "MongoDB (today): weak joins and relations for roles and permissions. Supabase: good, but we only need the database.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "w7JET",
          "name": "Row ORM",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "b8ggg",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "ORM",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "gLV5c",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Drizzle ORM",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "A9YUP",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Schema written in TypeScript, SQL-like queries that are fully typed, plain SQL migrations, small runtime.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "dv434",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Prisma: heavier client and slower cold starts. Raw SQL: no types.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "w99yI6",
          "name": "Row Auth",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "oOmaU",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Auth",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "GOreG",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Better Auth (organization + email code plugins)",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "UUKA6",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Free and open source, runs inside our API. Users, workspaces, members and invites live in our own Postgres next to everything else: one database to secure, no webhook sync. Passwordless (Google or a 6-digit email code), so there is nothing to hash or leak and it fits the Workers free CPU limit.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "HUnk5",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Clerk: hosted and quick to start, but paid past about 10,000 users, data synced by webhooks, and its UI pulls away from our design. Auth.js: weaker workspace and invite support.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "pqeSg",
          "name": "Row Drafting",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "d5DQQY",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Drafting",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "VZc42",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Claude API, structured output (claude-opus-5-5 for plans and diagrams, claude-haiku-5-5 for summaries and emails)",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "a67xqC",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Plan quality is the product, so drafts use the strongest current model. Structured output returns JSON that matches our Zod schema, so every draft becomes a reliable diff. One provider replaces today's three-provider fallback chain that mostly fails.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "o7rZE",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "claude-sonnet-5-5: about half the cost per draft, a later cost lever if quality holds in testing. OpenAI or Gemini: viable; a thin provider interface keeps this swappable.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "j6x9zS",
          "name": "Row Background jobs",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "ypuA4",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Background jobs",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Fqj5R",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Trigger.dev",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "pOd2c",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Drafts take 20 to 60 seconds, sync and drift checks run on schedules, weekly emails go out on Mondays. Durable jobs with retries, cron and a run log.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "i02MnP",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "BullMQ + Redis: another server to run. pg-boss: simpler, but weak at long jobs and no dashboard.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "CgDGg",
          "name": "Row File storage",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "M0tsm2",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "File storage",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "mdoKL",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Cloudflare R2",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "UUpUz",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Exports and attachments with no download fees and an S3-compatible API. Diagram scenes stay in Postgres as compressed JSONB.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "eRtrx",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "Backblaze B2 (today): fine, but R2 is free to download from and closer to the rest of the stack.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "P2a4DU",
          "name": "Row Email",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "o3YvNS",
              "name": "Layer",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 180,
              "content": "Email",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "QRPfN",
              "name": "Choice",
              "fill": "$accent",
              "textGrowth": "fixed-width",
              "width": 330,
              "content": "Resend + React Email",
              "lineHeight": 1.4,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "wEEkp",
              "name": "Why",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Weekly status, invites and review requests are React components using our design tokens, versioned with the code.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "pSOG8",
              "name": "Alt",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 370,
              "content": "SendGrid or Amazon SES: older APIs, templates live outside the codebase.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
